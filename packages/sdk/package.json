{
  "name": "@grudge-studio/sdk",
  "version": "0.3.2",
  "description": "Umbrella export — quality system for bake, character, units/NPC, animator, engine, deploy, editor stack.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "https://github.com/MolochDaGod/GrudgeStudioNPM.git",
    "directory": "packages/sdk"
  },
  "dependencies": {
    "@grudge-studio/core": "*",
    "@grudge-studio/asset-resolver": "*",
    "@grudge-studio/assets": "*",
    "@grudge-studio/animator": "*",
    "@grudge-studio/engine": "*",
    "@grudge-studio/stack": "*",
    "@grudge-studio/character": "*",
    "@grudge-studio/units": "*",
    "@grudge-studio/bake": "*",
    "@grudge-studio/deploy": "*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
