{
  "name": "@grudge-studio/asset-resolver",
  "version": "0.3.0",
  "description": "Canonical Grudge Studio image/asset URL resolver. Resolves every image to the Cloudflare R2 CDN (assets.grudge-studio.com) as the single source of truth, rewrites deprecated hosts, and provides icon fallbacks.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "grudge-studio",
    "cloudflare",
    "r2",
    "cdn",
    "assets",
    "images"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MolochDaGod/GrudgeStudioNPM.git",
    "directory": "packages/asset-resolver"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
